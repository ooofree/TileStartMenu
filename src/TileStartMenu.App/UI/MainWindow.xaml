<Window x:Class="TileStartMenu.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TileStartMenu.App.UI"
        Title="TileStartMenu"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Background="#0B0E14"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 纯平按钮模板：无圆角/无边框/无阴影 -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E6ECF2"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="14" />
        </Grid.RenderTransform>

        <!-- 内容区：横向滚动的磁贴墙 -->
        <ScrollViewer x:Name="WallScroll"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Hidden"
                      PanningMode="HorizontalOnly"
                      ScrollChanged="MainScroll_ScrollChanged">
            <Grid x:Name="ContentGrid" HorizontalAlignment="Left">
                <Canvas x:Name="TileCanvas" Background="Transparent"
                        MouseLeftButtonDown="WallBg_Down"
                        MouseMove="WallBg_Move"
                        MouseLeftButtonUp="WallBg_Up"/>
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                <!-- 空态纯装饰：必须 IsHitTestVisible=False，否则整块吃掉磁贴命中 -->
                <TextBlock x:Name="EmptyState" Visibility="Collapsed" IsHitTestVisible="False"
                           Foreground="#8B98A8" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Width="600"
                           Text="在「全部应用」里右键应用即可固定到此处"/>
            </Grid>
        </ScrollViewer>

        <!-- 分组总览层（语义缩放）：浮在磁贴墙上。
             放在时钟/齿轮/所有应用之前声明，使这些固定元素浮在本层之上，总览中仍可见可点。 -->
        <Grid x:Name="ZoomOverlay" Visibility="Collapsed" Background="#0B0E14">
            <Canvas x:Name="ZoomCanvas"/>
        </Grid>

        <!-- 右上角：电源按钮 + 时钟（Win8.1 风格，纯浮在磁贴墙上） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0">
            <TextBlock x:Name="ClockText" Foreground="#E6ECF2" FontSize="28" FontWeight="Light"
                       FontFamily="Segoe UI Light, Microsoft YaHei UI Light"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="0,0,18,0"/>
            <TextBlock x:Name="DateText" Foreground="#8B98A8" FontSize="13"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button x:Name="PowerButton" Content="⏻" Click="PowerButton_Click"
                    Style="{StaticResource FlatBtn}"
                    Width="40" Height="40" FontSize="18" Padding="0"
                    ToolTip="电源选项"/>
        </StackPanel>

        <!-- 右上角：齿轮（语义缩放/分组总览入口） -->
        <Button x:Name="SemanticZoomButton" Content="⚙" Click="SemanticZoom_Click"
                Style="{StaticResource FlatBtn}"
                Width="36" Height="36" FontSize="16" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,24,0"
                ToolTip="分组总览"/>

        <!-- 左下角「所有应用 ↓」入口 -->
        <Button x:Name="AllAppsEntry" Content="所有应用  ↓"
                Style="{StaticResource FlatBtn}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24,0,0,18" Padding="16,10" FontSize="14"
                Background="#1E2632" Foreground="#C8D2DC"
                Click="SwitchToAllApps_Click"/>

        <!-- 全部应用页 -->
        <local:AllAppsView x:Name="AllAppsPage" Visibility="Collapsed"/>

        <!-- 电源浮层 -->
        <Border x:Name="PowerPopup" Visibility="Collapsed"
                Background="#99000000" MouseLeftButtonDown="PowerCancel_Click">
            <Border Width="320" Padding="24" Background="#202836" CornerRadius="0"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseLeftButtonDown="PopupInner_Click">
                <Grid>
                    <StackPanel x:Name="PowerChooser">
                        <TextBlock Text="电源" Foreground="White" FontSize="18" FontWeight="Light" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource FlatBtn}" Content="关机" Click="PowerChoice_Click" Tag="Shutdown" Padding="12,10" HorizontalContentAlignment="Left" Margin="0,2"/>
                        <Button Style="{StaticResource FlatBtn}" Content="重启" Click="PowerChoice_Click" Tag="Restart" Padding="12,10" HorizontalContentAlignment="Left" Margin="0,2"/>
                        <Button Style="{StaticResource FlatBtn}" Content="睡眠" Click="PowerChoice_Click" Tag="Sleep" Padding="12,10" HorizontalContentAlignment="Left" Margin="0,2"/>
                        <Button Style="{StaticResource FlatBtn}" Content="锁屏" Click="PowerChoice_Click" Tag="Lock" Padding="12,10" HorizontalContentAlignment="Left" Margin="0,2"/>
                        <Button Style="{StaticResource FlatBtn}" Content="注销" Click="PowerChoice_Click" Tag="SignOut" Padding="12,10" HorizontalContentAlignment="Left" Margin="0,2"/>
                    </StackPanel>
                    <StackPanel x:Name="PowerConfirmPanel" Visibility="Collapsed">
                        <TextBlock x:Name="PowerTitle" Foreground="White" FontSize="20" FontWeight="Light" Margin="0,0,0,10"/>
                        <TextBlock x:Name="PowerConfirmText" Foreground="#B8C2CC" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatBtn}" Content="取消" Click="PowerCancel_Click" Width="90" Margin="0,0,8,0" Padding="8,6" Background="#2A3444"/>
                            <Button x:Name="PowerConfirmButton" Content="确定" Click="PowerConfirm_Click"
                                    Style="{StaticResource FlatBtn}" Width="90" Padding="8,6" Background="#C42B1C" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- 底部 App Bar -->
        <Border x:Name="AppBar" VerticalAlignment="Bottom" Visibility="Collapsed"
                Background="#202836" Height="92"
                MouseLeftButtonDown="AppBarBackground_Click">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AppBarTransform" Y="92" />
            </Border.RenderTransform>
            <DockPanel Margin="24,0">
                <TextBlock x:Name="AppBarTitle" DockPanel.Dock="Left"
                           Foreground="#C8D2DC" FontSize="15" FontWeight="Light"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel x:Name="AppBarButtons" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 错误条 -->
        <Border x:Name="ErrorBar" VerticalAlignment="Bottom" Visibility="Collapsed"
                Background="#C42B1C" Padding="16,8" Margin="0,0,0,100"
                HorizontalAlignment="Center">
            <TextBlock x:Name="ErrorText" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</Window>
