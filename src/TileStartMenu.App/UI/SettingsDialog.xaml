<Window x:Class="TileStartMenu.App.UI.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="设置">
    <StackPanel Margin="16">
        <CheckBox x:Name="WinKeyCheck" Content="接管 Win 键（取消勾选后由系统开始菜单响应）" Margin="0,0,0,8" />
        <CheckBox x:Name="StartupCheck" Content="开机自启" Margin="0,0,0,8" />
        <CheckBox x:Name="ClockCheck" Content="显示时钟" Margin="0,0,0,14" />

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="背景色" VerticalAlignment="Center" />
            <Button x:Name="BgColorButton" Grid.Column="1" Height="28" />
        </Grid>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="不透明度" VerticalAlignment="Center" />
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.5" Maximum="1.0" />
        </Grid>

        <Border BorderBrush="#444" BorderThickness="0,1,0,0" Margin="0,0,0,10" />
        <TextBlock Text="分组管理" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="GroupList" Height="130" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="NewGroupBtn" Content="新建分组" Width="90" Margin="0,0,8,0" />
            <Button x:Name="RenameGroupBtn" Content="重命名" Width="90" Margin="0,0,8,0" />
            <Button x:Name="DeleteGroupBtn" Content="删除" Width="90" />
        </StackPanel>

        <Border BorderBrush="#444" BorderThickness="0,1,0,0" Margin="0,0,0,10" />
        <TextBlock Text="数据" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Button x:Name="ResetCatalogBtn" Content="重置为全部应用（重新枚举本机应用，覆盖当前磁贴布局）"
                HorizontalAlignment="Stretch" Margin="0,0,0,6" Padding="8,6" />
        <TextBlock x:Name="CatalogStatusText" Foreground="#888" FontSize="11" Margin="0,0,0,12"
                   TextWrapping="Wrap" />

        <TextBlock Text="说明：以上开关仅保存到配置并即时生效；Win 键钩子与开机自启由系统集成层订阅。"
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Button x:Name="CloseButton" Content="关闭" Width="100" HorizontalAlignment="Right" IsCancel="True" />
    </StackPanel>
</Window>
