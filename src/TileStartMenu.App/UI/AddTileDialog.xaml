<Window x:Class="TileStartMenu.App.UI.AddTileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="添加磁贴">
    <StackPanel Margin="16">
        <TextBlock Text="类型" Margin="0,0,0,4" />
        <ComboBox x:Name="KindBox" Margin="0,0,0,10" />

        <TextBlock Text="目标" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Padding="4" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Width="90" />
        </Grid>
        <TextBlock x:Name="HintText" Foreground="#888" FontSize="11" Margin="0,-6,0,10"
                   TextWrapping="Wrap" />

        <TextBlock Text="名称" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,10" Padding="4" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="颜色" Margin="0,0,0,4" />
                <Button x:Name="ColorButton" Height="28" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="尺寸" Margin="0,0,0,4" />
                <ComboBox x:Name="SizeBox" />
            </StackPanel>
        </Grid>

        <TextBlock Text="目标分组" Margin="0,0,0,4" />
        <ComboBox x:Name="GroupBox" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="添加" Width="90" Margin="0,0,8,0" IsDefault="True" />
            <Button x:Name="CancelButton" Content="取消" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
